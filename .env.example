# OpenAI-compatible LLM endpoint (OmniRoute on private VPS).
# Copy to .env and fill in. NEVER commit .env.
LLM_BASE_URL=https://your-vps.example.com/v1
LLM_API_KEY=changeme
LLM_MODEL=changeme

# Tracing off by default; set to 1 to export OpenTelemetry spans to Phoenix
TRACING=0

# docker-compose service endpoints
PG_DSN=postgresql://ragbench:ragbench@localhost:5432/ragbench
QDRANT_URL=http://localhost:6333
