.mypy_cache/
.ruff_cache/
*.egg-info/

# model and embedding caches
.hf_cache/
hf_cache/
models/
*.bin
*.safetensors
*.onnx

# dashboard
.streamlit/secrets.toml

# sweep runtime state
.sweep_state.json

